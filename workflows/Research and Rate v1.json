      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  t.ticker,\n  t.company,\n  COUNT(p.*) FILTER (WHERE p.sentiment = 'Positive') AS pos_count,\n  COUNT(p.*) FILTER (WHERE p.sentiment = 'Neutral')  AS neu_count,\n  COUNT(p.*) FILTER (WHERE p.sentiment = 'Negative') AS neg_count\nFROM tickers t\nLEFT JOIN posts p\n  ON p.ticker = t.ticker\n AND p.observed_at > now() - interval '14 days'\nWHERE t.last_seen_at > now() - interval '14 days'\n  AND t.ticker !~ '[/[:space:]]'\nGROUP BY t.ticker, t.company\nORDER BY t.last_seen_at DESC\nLIMIT 200;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -1360,
        120
      ],
      "id": "33333333-3333-4333-9333-333333333333",
